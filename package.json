{
  "name": "gmail-mcp-server",
  "version": "1.3.0",
  "private": true,
  "description": "Lean Gmail MCP server with auto authentication support",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gmail-mcp": "./dist/index.js",
    "gmail-search": "./dist/cli/gmail-search.js",
    "gmail-get-message": "./dist/cli/gmail-get-message.js",
    "gmail-download-attachment": "./dist/cli/gmail-download-attachment.js",
    "gmail-batch-fetch-window": "./dist/cli/gmail-batch-fetch-window.js",
    "gmail-create-draft": "./dist/cli/gmail-create-draft.js",
    "gmail-get-attachment-text": "./dist/cli/gmail-get-attachment-text.js",
    "gmail-get-thread": "./dist/cli/gmail-get-thread.js",
    "gmail-get-inbox-with-threads": "./dist/cli/gmail-get-inbox-with-threads.js",
    "gmail-download-email": "./dist/cli/gmail-download-email.js"
  },
  "scripts": {
    "build": "tsc",
    "install-cli": "npm run build && node scripts/install-cli.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "auth": "node dist/index.js auth",
    "test": "vitest run --exclude '.worktrees/**'",
    "test:watch": "vitest",
    "lockfile:lint": "lockfile-lint --path package-lock.json --type npm --validate-https --validate-integrity --allowed-hosts npm cdn.sheetjs.com",
    "prepare": "npm run build",
    "roadmap:check": "node scripts/check-roadmap.mjs",
    "roadmap:check:staged": "node scripts/check-roadmap.mjs --staged",
    "verify": "node scripts/verify.mjs",
    "ci:watch": "node scripts/ci-watch.mjs"
  },
  "keywords": [
    "gmail",
    "mcp",
    "cursor",
    "ai",
    "oauth",
    "model-context-protocol",
    "google-gmail",
    "claude",
    "auto-auth"
  ],
  "author": "Alexander Golev",
  "contributors": [
    "Arty McLabin",
    "gongrzhe"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dansunotori/Gmail-MCP-Server.git"
  },
  "bugs": {
    "url": "https://github.com/dansunotori/Gmail-MCP-Server/issues"
  },
  "homepage": "https://github.com/dansunotori/Gmail-MCP-Server#readme",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "email-addresses": "^5.0.0",
    "google-auth-library": "^11.3.1",
    "googleapis": "^186.0.0",
    "mammoth": "^1.13.0",
    "mime-types": "^3.0.1",
    "nodemailer": "^10.1.2",
    "open": "^10.0.0",
    "pdfjs-dist": "^6.4.299",
    "turndown": "^7.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.1"
  },
  "overrides": {
    "mammoth": {
      "argparse": "^2.0.1"
    }
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/turndown": "^5.0.6",
    "lockfile-lint": "^5.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
